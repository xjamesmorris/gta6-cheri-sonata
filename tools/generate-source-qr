#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Generate the compact, display-ready source repository QR bitmap."""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import subprocess
import sys
import urllib.parse

ROOT = pathlib.Path(__file__).resolve().parent.parent
DEFAULT_URL = "https://github.com/xjamesmorris/gta6-cheri-sonata"

if not os.environ.get("GTA6_PREVIEW_SHELL"):
    os.execvp("nix", [
        "nix", "develop", "--accept-flake-config", f"{ROOT}#preview",
        "-c", str(ROOT / "tools/generate-source-qr"), *sys.argv[1:],
    ])

try:
    import qrcode
    from PIL import Image
except ImportError as error:
    raise SystemExit(f"error: QR generation dependencies unavailable: {error}") from error


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--url", default=DEFAULT_URL)
    parser.add_argument("--output", type=pathlib.Path, default=ROOT / "firmware/source_qr.h")
    parser.add_argument("--preview", type=pathlib.Path)
    parser.add_argument("--verify-image", type=pathlib.Path,
                        help="Independently decode a rendered QR screenshot with zbar")
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    parsed = urllib.parse.urlsplit(args.url)
    if (not args.url.isascii() or parsed.scheme != "https" or not parsed.netloc or
            parsed.username or parsed.password or
            any(ord(character) < 33 or ord(character) == 127 for character in args.url)):
        parser.error("--url must be an ASCII HTTPS source URL without credentials or whitespace")

    qr = qrcode.QRCode(error_correction=qrcode.constants.ERROR_CORRECT_M, border=4, box_size=1)
    qr.add_data(args.url, optimize=0)
    qr.make(fit=True)
    matrix = qr.get_matrix()
    side = len(matrix)
    if side * 2 > 124:
        parser.error("source URL is too long for a readable QR code on the 128x160 display")
    stride = (side + 7) // 8
    lines = [
        "// Generated by tools/generate-source-qr; do not edit by hand.",
        "// SPDX-License-Identifier: MIT",
        "#pragma once",
        "#include <stdint.h>",
        "",
        f"constexpr char SourceRepoUrl[] = {json.dumps(args.url, ensure_ascii=True)};",
        f"constexpr uint32_t SourceQrSize = {side};",
        f"constexpr uint8_t SourceQrBits[{side}][{stride}] = {{",
    ]
    for row in matrix:
        packed = [0] * stride
        for column, black in enumerate(row):
            if black:
                packed[column // 8] |= 0x80 >> (column % 8)
        lines.append("    {" + ", ".join(f"0x{value:02x}" for value in packed) + "},")
    lines += ["};", ""]
    header = "\n".join(lines)
    if args.check:
        if not args.output.is_file() or args.output.read_text() != header:
            raise SystemExit(f"FAIL: {args.output} is out of date; run tools/generate-source-qr")
        print(f"OK: source QR matches {args.url} ({side} modules including quiet zone)")
    else:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(header)
        print(f"Wrote {args.output} ({side} modules including quiet zone)")
    if args.preview:
        image = Image.new("L", (side, side), 255)
        image.putdata([0 if black else 255 for row in matrix for black in row])
        args.preview.parent.mkdir(parents=True, exist_ok=True)
        image.resize((side * 4, side * 4), Image.Resampling.NEAREST).save(args.preview)
    if args.verify_image:
        decoded = subprocess.run(
            ["zbarimg", "--quiet", "--raw", str(args.verify_image)],
            capture_output=True, text=True, check=True,
        )
        if decoded.stdout.strip() != args.url:
            raise SystemExit("FAIL: rendered QR does not identify the expected source repository")
        print(f"OK: rendered QR decodes to {args.url}")


if __name__ == "__main__":
    main()
