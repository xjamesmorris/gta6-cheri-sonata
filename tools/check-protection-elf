#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Check handler placement and probe minimum-stack metadata in component ELFs."""

from __future__ import annotations

import argparse
import json
import pathlib
import struct

ROOT = pathlib.Path(__file__).resolve().parent.parent


def symbols(path: pathlib.Path):
    data = path.read_bytes()
    if len(data) < 52 or data[:6] != b"\x7fELF\x01\x01":
        raise ValueError(f"{path}: expected little-endian ELF32")
    section_offset = struct.unpack_from("<I", data, 32)[0]
    entry_size, count = struct.unpack_from("<HH", data, 46)
    if entry_size != 40 or section_offset + count * entry_size > len(data):
        raise ValueError(f"{path}: invalid section table")
    sections = [
        struct.unpack_from("<10I", data, section_offset + i * entry_size)
        for i in range(count)
    ]
    found = {}
    for section in sections:
        if section[1] != 2:
            continue
        if section[6] >= count or section[9] != 16 or section[5] % 16:
            raise ValueError(f"{path}: invalid symbol table")
        strings = sections[section[6]]
        if strings[4] + strings[5] > len(data) or section[4] + section[5] > len(data):
            raise ValueError(f"{path}: truncated symbol data")
        names = data[strings[4]:strings[4] + strings[5]]
        for offset in range(section[4], section[4] + section[5], 16):
            name, value, size, info, _, index = struct.unpack_from("<IIIBBH", data, offset)
            end = names.find(b"\0", name)
            if name >= len(names) or end < 0:
                raise ValueError(f"{path}: invalid symbol name")
            label = names[name:end].decode("utf-8")
            file_offset = None
            remaining = 0
            executable = False
            if 0 < index < count:
                target = sections[index]
                relative = value - target[3]
                if (target[1] != 8 and target[4] + target[5] <= len(data) and
                        relative >= 0 and relative <= target[5]):
                    file_offset = target[4] + relative
                    remaining = target[5] - relative
                    executable = bool(target[2] & 4)
            found[label] = {
                "type": info & 15, "section": index, "size": size,
                "offset": file_offset, "info_offset": offset + 12,
                "remaining": remaining, "executable": executable,
            }
    return data, found


def component_path(report, name: str, root: pathlib.Path = ROOT):
    paths = {
        pathlib.Path(item["file"])
        for item in report["compartments"][name]["code"]["inputs"]
        if item["file"].endswith(".compartment")
    }
    if len(paths) != 1:
        raise ValueError(f"{name}: expected one component ELF")
    path = paths.pop()
    return path if path.is_absolute() else root / path


def verify(report, root: pathlib.Path = ROOT):
    minimums = {}
    for name in ("wallpaper", "game_wallet", "cap_probe"):
        path = component_path(report, name, root)
        data, entries = symbols(path)
        handler = entries.get("compartment_error_handler", {})
        present = (handler.get("type") == 2 and handler.get("executable") and
                   0 < handler.get("size", 0) <= handler.get("remaining", 0))
        if name == "cap_probe" and not present:
            raise ValueError("cap_probe: executable error handler missing")
        if name != "cap_probe" and present:
            raise ValueError(f"{name}: error handler must not be installed")
        if name == "cap_probe":
            for symbol in ("__export_cap_probe__Z11probe_storePvjh",
                           "__export_cap_probe__Z12probe_retainPv"):
                entry = entries.get(symbol, {})
                offset = entry.get("offset")
                if offset is None or entry.get("remaining", 0) < 4 or offset + 4 > len(data):
                    raise ValueError(f"{symbol}: export entry missing")
                minimum = data[offset + 2] * 8
                if minimum != 512:
                    raise ValueError(f"{symbol}: minimum stack is {minimum}, expected 512")
                minimums[symbol] = minimum
    return minimums


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("report", type=pathlib.Path)
    args = parser.parse_args()
    try:
        report = json.loads(args.report.read_text())
        verify(report)
    except (OSError, ValueError, KeyError, struct.error) as error:
        raise SystemExit(f"FAIL: protection ELF metadata: {error}") from error
    print("OK: cap_probe alone has a handler; both faulting entries require 512 stack bytes")


if __name__ == "__main__":
    main()
